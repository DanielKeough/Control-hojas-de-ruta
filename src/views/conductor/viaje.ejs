<div class="mb-3">
  <a href="/mis-viajes" class="btn btn-outline-secondary btn-sm">&larr; Mis Viajes</a>
</div>
<h5 class="mb-3">HR-<%= String(hoja.id).padStart(6,'0') %> — <%= hoja.transportista.razonSocial %> (<%= hoja.camion.patente %>)</h5>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="post" action="/mis-viajes/<%= hoja.id %>">
  <% hoja.detalles.forEach(function(d) { %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Destino #<%= d.ordenPrioridad %> — <%= d.cliente.razonSocial %> / <%= d.sucursal.nombre %></span>
        <% if (d.tramoValidado) { %>
          <span class="badge bg-success">Validado por Portería</span>
        <% } else { %>
          <span class="badge bg-secondary">Pendiente de validación</span>
        <% } %>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-6">
            <label class="form-label">Km inicio de tramo</label>
            <input type="number" step="0.01" inputmode="decimal" class="form-control form-control-lg"
              name="detalles[d<%= d.id %>][kmInicio]" value="<%= d.kmInicio != null ? d.kmInicio : '' %>" <%= d.tramoValidado ? 'disabled' : '' %>>
          </div>
          <div class="col-6">
            <label class="form-label">Hora inicio de tramo</label>
            <input type="time" class="form-control form-control-lg"
              name="detalles[d<%= d.id %>][horaInicioTramo]" value="<%= d.horaInicioTramo || '' %>" <%= d.tramoValidado ? 'disabled' : '' %>>
          </div>
          <div class="col-6">
            <label class="form-label">Km fin de tramo</label>
            <input type="number" step="0.01" inputmode="decimal" class="form-control form-control-lg"
              name="detalles[d<%= d.id %>][kmFin]" value="<%= d.kmFin != null ? d.kmFin : '' %>" <%= d.tramoValidado ? 'disabled' : '' %>>
          </div>
          <div class="col-6">
            <label class="form-label">Hora fin de tramo</label>
            <input type="time" class="form-control form-control-lg"
              name="detalles[d<%= d.id %>][horaFinTramo]" value="<%= d.horaFinTramo || '' %>" <%= d.tramoValidado ? 'disabled' : '' %>>
          </div>
        </div>
      </div>
    </div>
  <% }); %>

  <button type="submit" class="btn btn-primary btn-lg w-100 mb-5">Guardar</button>
</form>
