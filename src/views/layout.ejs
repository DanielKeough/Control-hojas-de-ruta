<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Hojas de Ruta</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <% if (user) { %>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Hojas de Ruta</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <% if (['LOGISTICA','PORTERIA','CONDUCTOR','ADMINISTRACION'].includes(user.rol)) { %>
            <li class="nav-item"><a class="nav-link" href="/hojas-ruta">Hojas de Ruta</a></li>
          <% } %>
          <% if (['LOGISTICA','ADMINISTRACION'].includes(user.rol)) { %>
            <li class="nav-item"><a class="nav-link" href="/hojas-ruta/nueva">Nueva Hoja de Ruta</a></li>
          <% } %>
          <% if (['PORTERIA','ADMINISTRACION'].includes(user.rol)) { %>
            <li class="nav-item"><a class="nav-link" href="/control">Control y Cierre</a></li>
          <% } %>
          <% if (user.rol === 'CONDUCTOR') { %>
            <li class="nav-item"><a class="nav-link" href="/mis-viajes">Mis Viajes</a></li>
          <% } %>
          <% if (user.rol === 'ADMINISTRACION') { %>
            <li class="nav-item"><a class="nav-link" href="/facturacion">Imputacion Factura</a></li>
          <% } %>
          <% if (['LOGISTICA','PORTERIA','ADMINISTRACION'].includes(user.rol)) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Maestros</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/maestros/transportistas">Transportes</a></li>
                <li><a class="dropdown-item" href="/maestros/conductores">Conductores</a></li>
                <li><a class="dropdown-item" href="/maestros/camiones">Camiones</a></li>
                <li><a class="dropdown-item" href="/maestros/acoplados">Acoplados</a></li>
                <li><a class="dropdown-item" href="/maestros/clientes">Clientes</a></li>
                <li><a class="dropdown-item" href="/maestros/sucursales">Sucursales</a></li>
                <% if (user.rol === 'ADMINISTRACION') { %>
                  <li><a class="dropdown-item" href="/maestros/usuarios">Usuarios</a></li>
                <% } %>
              </ul>
            </li>
          <% } %>
        </ul>
        <span class="navbar-text text-light me-3"><%= user.nombre %> (<%= user.rol %>)</span>
        <form action="/logout" method="post" class="d-flex">
          <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
        </form>
      </div>
    </div>
  </nav>
  <% } %>
  <div class="container-fluid px-4 pb-5">
    <%- body %>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
