<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hoja de Ruta HR-<%= String(hoja.id).padStart(6,'0') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { padding: 24px; font-size: 14px; }
    .firma-linea { border-top: 1px solid #333; margin-top: 40px; padding-top: 4px; font-size: 11px; color: #444; }
    table th, table td { font-size: 12.5px; }
    @media print {
      .no-print { display: none !important; }
      body { padding: 0; }
      .destino-block { page-break-inside: avoid; }
      @page { margin: 1.2cm; }
    }
  </style>
</head>
<body>
  <div class="no-print d-flex justify-content-between align-items-center mb-4 p-2 bg-light border rounded">
    <a href="/hojas-ruta/<%= hoja.id %>" class="btn btn-outline-secondary btn-sm">&larr; Volver</a>
    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
      <i class="bi bi-printer"></i> Imprimir
    </button>
  </div>

  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h4 class="mb-0">HOJA DE RUTA</h4>
      <h5 class="text-muted">HR-<%= String(hoja.id).padStart(6,'0') %></h5>
    </div>
    <div class="text-end small">
      <div><strong>Fecha de impresión:</strong> <%= new Date().toLocaleString('es-AR') %></div>
      <div><strong>Estado:</strong> <%= hoja.estado %></div>
    </div>
  </div>

  <table class="table table-bordered table-sm mb-4">
    <tbody>
      <tr>
        <th class="bg-light" style="width:18%">Fecha y hora emisión</th>
        <td style="width:32%"><%= new Date(hoja.fechaHoraEmision).toLocaleString('es-AR') %></td>
        <th class="bg-light" style="width:18%">Transporte</th>
        <td><%= hoja.transportista.razonSocial %></td>
      </tr>
      <tr>
        <th class="bg-light">Patente camión</th>
        <td><%= hoja.camion.patente %></td>
        <th class="bg-light">Patente acoplado</th>
        <td><%= hoja.acoplado ? hoja.acoplado.patente : '-' %></td>
      </tr>
      <tr>
        <th class="bg-light">Conductor</th>
        <td><%= hoja.conductor.apellido %>, <%= hoja.conductor.nombre %></td>
        <th class="bg-light">DNI conductor</th>
        <td><%= hoja.conductor.dni %></td>
      </tr>
      <tr>
        <th class="bg-light">Ticket pesada balanza</th>
        <td><%= hoja.ticketPesadaBalanza || '-' %></td>
        <th class="bg-light">Tara / Peso bruto</th>
        <td><%= hoja.tara != null ? hoja.tara + ' kg' : '-' %> / <%= hoja.pesoBruto != null ? hoja.pesoBruto + ' kg' : '-' %></td>
      </tr>
    </tbody>
  </table>

  <% hoja.detalles.forEach(function(d) { %>
    <div class="destino-block mb-4">
      <h6 class="border-bottom pb-1">Destino #<%= d.ordenPrioridad %> — <%= d.cliente.razonSocial %> / <%= d.sucursal.nombre %></h6>
      <div class="small mb-2">
        <strong>Domicilio de entrega:</strong> <%= d.domicilioEntrega %>
        <% if (d.sucursal.localidad) { %> · <strong>Localidad:</strong> <%= d.sucursal.localidad %><% } %>
        <% if (d.sucursal.provincia) { %> · <strong>Provincia:</strong> <%= d.sucursal.provincia %><% } %>
        <% if (d.numeroTurno) { %> · <strong>Turno:</strong> <%= d.numeroTurno %><% } %>
        <% if (d.horaTurno) { %> · <strong>Hora:</strong> <%= d.horaTurno %><% } %>
        <% if (d.rangoHorarioDesde || d.rangoHorarioHasta) { %> · <strong>Rango:</strong> <%= d.rangoHorarioDesde||'' %> - <%= d.rangoHorarioHasta||'' %><% } %>
        <% if (d.numeroOrdenCompra) { %> · <strong>OC:</strong> <%= d.numeroOrdenCompra %><% } %>
      </div>
      <table class="table table-bordered table-sm">
        <thead class="table-light">
          <tr>
            <th>Remito</th>
            <th>Kilos</th>
            <th>Pallets</th>
            <th>IFCO</th>
            <th>Recepción</th>
            <th>Kilos recibidos</th>
            <th>Entrega</th>
            <% if (user.rol === 'ADMINISTRACION') { %><th>N° Factura</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% d.remitos.forEach(function(r) { %>
            <tr>
              <td><%= r.numeroRemito %></td>
              <td><%= r.kilosDespachados %></td>
              <td><%= r.palletsDespachados %></td>
              <td><%= r.cantidadIfco %></td>
              <td><%= r.recepcionEstado %></td>
              <td><%= r.kilosRecepcionados != null ? r.kilosRecepcionados : '-' %></td>
              <td><%= r.estadoEntrega %></td>
              <% if (user.rol === 'ADMINISTRACION') { %><td><%= r.numeroFactura || '-' %></td><% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="row">
        <div class="col-6">
          <div class="firma-linea">Firma y aclaración — Conductor</div>
        </div>
        <div class="col-6">
          <div class="firma-linea">Firma y aclaración — Recepción conforme</div>
        </div>
      </div>
    </div>
  <% }); %>

  <script>
    if (new URLSearchParams(window.location.search).get('auto') === '1') {
      window.print();
    }
  </script>
</body>
</html>
