<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><%= cfg.titulo %></h4>
  <% if (puedeEscribir) { %>
    <a href="/maestros/<%= key %>/nuevo" class="btn btn-primary btn-sm">+ Nuevo <%= cfg.singular %></a>
  <% } %>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<table class="table table-sm table-striped bg-white">
  <thead>
    <tr>
      <th>#</th>
      <% displayFields.forEach(function(f) { %>
        <th><%= f.label %></th>
      <% }); %>
      <th class="text-end">Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr class="<%= item.activo === false ? 'text-muted' : '' %>">
        <td><%= item.id %></td>
        <% displayFields.forEach(function(f) { %>
          <td>
            <% if (f.type === 'checkbox') { %>
              <%= item[f.name] ? 'Sí' : 'No' %>
            <% } else if (f.type === 'select' && f.optionsKey) { %>
              <% const opt = (optionsMap[f.name] || []).find(o => o.value === item[f.name]); %>
              <%= opt ? opt.label : '-' %>
            <% } else if ((f.type === 'select' || f.type === 'radio') && f.options) { %>
              <% const opt = f.options.find(o => o.value === item[f.name]); %>
              <%= opt ? opt.label : (item[f.name] || '-') %>
            <% } else if (f.type === 'multicheckbox') { %>
              <% const valores = item[f.name] || []; %>
              <% const labels = f.options.filter(o => valores.includes(o.value)).map(o => o.label); %>
              <%= labels.length ? labels.join(', ') : '-' %>
            <% } else if (f.type === 'date') { %>
              <%= item[f.name] ? new Date(item[f.name]).toLocaleDateString('es-AR') : '-' %>
            <% } else { %>
              <%= item[f.name] != null && item[f.name] !== '' ? item[f.name] : '-' %>
            <% } %>
          </td>
        <% }); %>
        <td class="text-end text-nowrap">
          <a href="/maestros/<%= key %>/<%= item.id %>" class="btn btn-outline-secondary btn-sm" title="Ver detalle">
            <i class="bi bi-eye"></i>
          </a>
          <% if (puedeEscribir) { %>
            <a href="/maestros/<%= key %>/<%= item.id %>/editar" class="btn btn-outline-primary btn-sm" title="Editar">
              <i class="bi bi-pencil"></i>
            </a>
          <% } %>
          <% if (puedeEliminar) { %>
            <form action="/maestros/<%= key %>/<%= item.id %>/eliminar" method="post" class="d-inline"
              onsubmit="return confirm('¿Eliminar este registro? Esta acción no se puede deshacer.');">
              <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                <i class="bi bi-trash"></i>
              </button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    <% if (items.length === 0) { %>
      <tr><td colspan="20" class="text-center text-muted">No hay registros cargados.</td></tr>
    <% } %>
  </tbody>
</table>
