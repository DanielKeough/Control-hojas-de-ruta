# Cadena de conexion a la base de datos PostgreSQL (Supabase, Neon, etc.)
# En Supabase: Project Settings > Database > Connection string (modo "Transaction" o "Session")
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd?schema=public"

# Clave secreta para firmar los tokens de sesion (JWT). Usar un valor largo y aleatorio.
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Puerto en el que corre el servidor (Render lo asigna automaticamente en PORT)
PORT=3000

# Datos del usuario administrador inicial que crea el script de seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar123
ADMIN_NOMBRE="Administrador"
